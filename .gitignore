# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 로컬 플러그인 상태 (omc)
/.omc/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# grill 문답 원문 (로컬 전용 — 공개 레포 제외)
/docs/grill-log.md
.proto-shots/

# 에이전트 도구 로컬 상태 (커밋 대상 아님)
/.claude/
/.serena/

# 시드 스크립트 — 로컬 검증용, 추적 제외 판정(2026-08-27)
/seed.ts
# 런칭 시드 카드 — 삽입 완료(2026-08-28), 되돌릴 때만 필요
