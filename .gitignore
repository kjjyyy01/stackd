# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 로컬 플러그인 상태 (omc)
/.omc/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# grill 문답 원문 (로컬 전용 — 공개 레포 제외)
/docs/grill-log.md
.proto-shots/

# 에이전트 도구 로컬 상태 (커밋 대상 아님)
/.claude/
/.serena/

# 시드 스크립트 — 로컬 검증용, 추적 제외 판정(2026-08-27)
/seed.ts
# 런칭 시드 카드 — 삽입 완료(2026-08-28), 되돌릴 때만 필요
/seed-cards.ts
# 위 두 스크립트 공용 admin 클라이언트 헬퍼 — 같은 추적 제외 판정
/seed-db.ts

# playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright*/

# archify 다이어그램 산출물 — 스펙(architecture.archify.json)에서 재생성 가능(2026-09-20)
# HTML 824KB + 검증 PNG 746KB. 원본은 스펙 1개뿐이라 산출물은 추적하지 않는다
/docs/architecture.html
/docs/architecture.visual-check.*
