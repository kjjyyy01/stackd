# Stackd 환경변수 (SSOT: docs/prd/17_환경_설정_배포.md)
# 복사: cp .env.example .env.local  → 값 채우기. .env.local은 커밋 금지.
# Vercel: Production / Preview 각각 등록. NEXT_PUBLIC_ 은 아래 4개만.
# Supabase 새 대시보드는 키 이름이 다름 — publishable(sb_publishable_…) = anon 자리, secret(sb_secret_…) = service role 자리.

# ── Supabase (프로젝트 → Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # 서버 전용 — feedback 저장·admin·탈퇴

# ── 사이트 ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # 절대 URL 기준 (prod: https://stackd.kr, 없으면 stackd.kr 폴백)

# ── 분석 ──
NEXT_PUBLIC_GA_ID=                    # GA4 측정 ID (G-XXXXXXXXXX)

# ── 알림·운영 (서버 전용) ──
SLACK_WEBHOOK_URL=                    # Slack Incoming Webhook — 신고·문의 알림
ADMIN_USER_IDS=                       # admin uuid 콤마 구분 (첫 로그인 후 Auth → Users에서 복사)
